# Copy to /opt/intelligence/.env on the VPS and chmod 600. Never commit the filled file.
# Generate a session secret with: openssl rand -base64 48

SESSION_SECRET=

# Resend API key. Server only. Do not commit the real key.
RESEND_API_KEY=

# Interim sender. fieldschool.ai is the only verified Resend domain today.
# Sign-in codes come from this address until benjohnson.ai is verified in Resend.
# Then change this to a mailbox on benjohnson.ai. No new domain is required to ship.
AUTH_FROM_EMAIL="Intelligence <noreply@fieldschool.ai>"

# Exact allowlist, comma-separated. Anyone else gets the same generic response and no email.
ALLOWLIST_EMAILS=bjljohnson2012@gmail.com,alexander.varden@gmail.com

PORT=8787
# Loopback only. Caddy reaches this address; do not publish 8787 on the public internet.
HOST=127.0.0.1
