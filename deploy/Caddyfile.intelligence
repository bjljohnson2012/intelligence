intelligence.benjohnson.ai {
	encode gzip
	header X-Robots-Tag "noindex, nofollow"
	# The Node app on 127.0.0.1:8787 serves the plan and the sign-in session.
	# Do not serve files from Caddy. People who are not signed in never see the plan.
	reverse_proxy 127.0.0.1:8787
	log {
		output file /data/intelligence.access.log
	}
}
